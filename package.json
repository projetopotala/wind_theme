{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/run-vinext.mjs dev",
    "build": "node scripts/run-vinext.mjs build",
    "start": "node scripts/run-vinext.mjs start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:portal": "node --test tests/potala/*.test.mjs",
    "prepare:arrival-plate": "node scripts/prepare-arrival-plate-assets.mjs",
    "prepare:atendimentos": "node scripts/prepare-atendimentos-panes.mjs",
    "preview:portal": "node scripts/serve-outputs.mjs",
    "logs": "vercel logs --follow",
    "prepare:arrival-v2": "node scripts/prepare-arrival-v2-assets.mjs",
    "prepare:palace": "node scripts/prepare-palace-assets.mjs",
    "prepare:home-travessia": "node scripts/prepare-home-travessia-assets.mjs",
    "vendor:three": "node scripts/vendor-three.mjs",
    "vendor:supabase": "node scripts/vendor-supabase.mjs",
    "validate:portal": "node scripts/validate-portal-assets.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .worktrees --ignore-pattern outputs/vendor",
    "db:generate": "drizzle-kit generate",
    "build:media-manifest": "node scripts/build-media-manifest.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.57.4",
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "sharp": "^0.35.3",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vercel": "^59.11.7",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
