{
  "buildCommand": "node ../scripts/ambiente-supabase.mjs producao",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin.html"
    },
    {
      "source": "/blog",
      "destination": "/blog-admin.html"
    },
    {
      "source": "/blog/",
      "destination": "/blog-admin.html"
    },
    {
      "source": "/confirmar-conta",
      "destination": "/confirmar-conta.html"
    },
    {
      "source": "/confirmar-conta/",
      "destination": "/confirmar-conta.html"
    },
    {
      "source": "/redefinir-senha",
      "destination": "/redefinir-senha.html"
    },
    {
      "source": "/redefinir-senha/",
      "destination": "/redefinir-senha.html"
    },
    {
      "source": "/meu-potala",
      "destination": "/meu-potala.html"
    },
    {
      "source": "/meu-potala/:path*",
      "destination": "/meu-potala.html"
    }
  ]
}
