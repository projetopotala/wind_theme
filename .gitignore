# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.npm-cache/
/.pnpm-store/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

/dist/
/.wrangler/

/work/
/.worktrees/

# ferramentas locais (a de brainstorm guarda token de sessão e PIDs)
/.claude/
/.superpowers/
/.openai/

# O vídeo de ORIGEM da travessia fica fora do repositório: são 19,4 MB, e o git
# guarda binários para sempre — adicionar depois é trivial, tirar do histórico
# não é. O que o site serve é o encode de 7,3 MB em outputs/media/, esse sim
# versionado, e a receita para refazê-lo está em
# scripts/prepare-home-travessia-video.mjs.
/assets-source/home-travessia/home-travessia-source.mp4
